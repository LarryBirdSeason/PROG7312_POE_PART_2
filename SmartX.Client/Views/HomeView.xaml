<UserControl x:Class="SmartX.Client.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
        <TextBlock Text="Smart-X" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Choose a module from the menu or below." Foreground="#94A3B8" FontSize="14"
                   HorizontalAlignment="Center" Margin="0,4,0,28"/>

        <Button Style="{StaticResource PillarButton}" Height="56" Command="{Binding OpenTelemetryCommand}"
                Content="1  Sensor Data Ingestion and Telemetry" Margin="0,0,0,12"/>
        <Button Style="{StaticResource PillarButton}" Height="56" Command="{Binding OpenCommandStreamCommand}"
                Content="2  Real-Time Command Stream and History" Margin="0,0,0,12"/>
        <Button Style="{StaticResource PillarButtonDisabled}" Height="56" IsEnabled="False"
                Content="3  Network Topology and Mesh Routing (final PoE)"/>
    </StackPanel>
</UserControl>
