<UserControl x:Class="SmartX.Client.Views.CommandStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111C30"/>
            <Setter Property="BorderBrush" Value="#1E2B44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7F1D1D" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding ApiOffline, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ConnectionMessage}" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock Text="{Binding PipelineText}" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding RateText}" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding LoadText}" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding AlertsText}" Style="{StaticResource Muted}"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.5*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Devices" Style="{StaticResource Heading}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by name, MAC, location or type. Press Enter to log the search."
                                 Padding="6" Margin="0,0,0,6">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding AlertOptions}"
                                      SelectedItem="{Binding SelectedAlertFilter}"/>
                        </Grid>
                        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="8,6" Margin="0,2" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="Transparent" Background="#0F192B">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding AlertText}" Foreground="#F59E0B" FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ValueText}" Foreground="White" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                            <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="5,1"
                                                    HorizontalAlignment="Right" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold"
                                                           Foreground="#0B1220"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="#F59E0B"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Live chart" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding ChartCaption}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <Canvas Width="{Binding ChartCanvasWidth}" Height="{Binding ChartCanvasHeight}"
                                    Background="#0B1220" ClipToBounds="True">
                                <Line X1="0" X2="560" Y1="{Binding CritHighY}" Y2="{Binding CritHighY}"
                                      Stroke="#EF4444" StrokeDashArray="4 3" StrokeThickness="1"
                                      Visibility="{Binding HasCritHigh, Converter={StaticResource BoolToVis}}"/>
                                <Line X1="0" X2="560" Y1="{Binding CritLowY}" Y2="{Binding CritLowY}"
                                      Stroke="#EF4444" StrokeDashArray="4 3" StrokeThickness="1"
                                      Visibility="{Binding HasCritLow, Converter={StaticResource BoolToVis}}"/>
                                <Polyline Points="{Binding ChartPoints}" Stroke="#38BDF8" StrokeThickness="2"
                                          StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Dashed red lines mark the critical limits." Style="{StaticResource Muted}"
                                   FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Manual override" Style="{StaticResource Heading}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Turn ON" Command="{Binding TurnOnCommand}" Style="{StaticResource ActionButton}"/>
                            <Button Content="Turn OFF" Command="{Binding TurnOffCommand}" Style="{StaticResource ActionButton}"/>
                            <Button Content="Shut all valves" Command="{Binding ShutdownValvesCommand}"
                                    Style="{StaticResource ActionButton}"/>
                            <Button Content="{Binding UndoText}" Command="{Binding UndoCommand}"
                                    Style="{StaticResource ActionButton}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                   Text="Overrides apply to pumps, valves and relays. Select one in the list."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Command history" Style="{StaticResource Heading}"/>
                        <ListBox ItemsSource="{Binding CommandLog}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}"
                                                   Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Description}" Foreground="White"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="4"
                                                Padding="5,1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="#0B1220"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Suggested Actions  ·  Automated Insights"
                                   Style="{StaticResource Heading}"/>
                        <ListBox x:Name="InsightList" ItemsSource="{Binding Insights}" Background="Transparent"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding AccentBrush}" BorderThickness="3,0,0,0"
                                            Background="#0F192B" Padding="10,6" Margin="0,3">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}"
                                                           Foreground="{Binding AccentBrush}" FontSize="10"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Title}" Foreground="White"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,4"/>
                                            <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Muted}"
                                                       FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="{Binding ApplyLabel}" Style="{StaticResource ActionButton}"
                                                        Command="{Binding DataContext.ApplyInsightCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Show device" Style="{StaticResource ActionButton}"
                                                        Command="{Binding DataContext.ShowDeviceCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Learned patterns" Style="{StaticResource Heading}"/>
                        <ItemsControl ItemsSource="{Binding Patterns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2">
                                        <Run Text="{Binding Description, Mode=OneWay}"/>
                                        <Run Text="{Binding Support, StringFormat=' (seen {0}x)', Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Active alerts" Style="{StaticResource Heading}"/>
                        <ListBox ItemsSource="{Binding Alerts}" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" Padding="8,3"
                                            Margin="0,2" Background="#0F192B">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap" FontSize="11"/>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}"
                                                       FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
